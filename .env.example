# Copy to .env and fill in what you have. .env is gitignored — keep it that way.
# Nothing here is required to start. The Account Researcher works with web search alone.

# --- Research -------------------------------------------------------------
WEB_SEARCH_API_KEY=
CONTACT_ENRICHMENT_API_KEY=
NEWS_API_KEY=

# --- Chat (pick one) ------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
# TEAMS_WEBHOOK_URL=

# --- Mail + calendar (pick one) -------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=

# --- CRM (optional) -------------------------------------------------------
CRM_BASE_URL=
CRM_API_KEY=

# --- Behaviour ------------------------------------------------------------
# Leave true unless you have a very good reason. See automations/README.md.
REQUIRE_APPROVAL_BEFORE_SEND=true
REQUIRE_APPROVAL_BEFORE_CRM_WRITE=true
